{
  "name": "@lithosid/bbs-node",
  "version": "0.1.4",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "native/darwin_arm64",
    "native/linux_amd64"
  ],
  "scripts": {
    "build": "npm run build:native && npm run build:ts",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml && node scripts/copy-native.cjs",
    "build:ts": "tsc -p tsconfig.json",
    "test": "node --test dist/*.test.js",
    "publish": "npm stage publish"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^5.9.3"
  }
}
